# -------------------------------------------------------------------------
# Ambiente E2E do Ágora — modelo para .env.e2e.local (nunca comitar valores)
# -------------------------------------------------------------------------
# Este arquivo lista APENAS os NOMES das variáveis exigidas pelos scripts
# em scripts/e2e/ e pelas suítes em e2e/. Valores reais devem viver em:
#   - .env.e2e.local (git-ignored)
#   - cofre de secrets do CI
#
# Nunca envie senhas, tokens ou segredos TOTP pelo chat.
# -------------------------------------------------------------------------

# URL local ou de homologação explicitamente autorizada.
E2E_BASE_URL=

# URL de conexão Postgres do ambiente E2E. Deve apontar para banco
# NÃO produtivo. Ex.: postgres://postgres:...@localhost:5432/postgres
E2E_DATABASE_URL=

# URL pública e chave publishable do Supabase E2E. NUNCA a service role.
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=

# Contas sintéticas — devem ser criadas manualmente uma única vez
# (ver docs/testing/work-area-e2e-bootstrap.md).
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_OWNER_TOTP_SECRET=

E2E_TEAM_EMAIL=
E2E_TEAM_PASSWORD=
E2E_TEAM_TOTP_SECRET=

E2E_TECH_EMAIL=
E2E_TECH_PASSWORD=
E2E_TECH_TOTP_SECRET=
